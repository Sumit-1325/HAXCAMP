# ---------------------------------------------------------------------------
# NEXORA backend environment
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Database Access user + cluster host)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexora?retryWrites=true&w=majority

# Long random string used to sign admin JWTs
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Comma separated list of allowed browser origins (no wildcard)
CORS_ORIGINS=http://localhost:5173

# Products at or below this stock level are counted as low stock
LOW_STOCK_THRESHOLD=5

# Seeded admin account (private credentials)
ADMIN_NAME=NEXORA Admin
ADMIN_EMAIL=admin@nexora.dev
ADMIN_PASSWORD=change-this-password

# Seeded demo admin account (these get published in the README)
DEMO_ADMIN_NAME=Demo Admin
DEMO_ADMIN_EMAIL=demo@nexora.dev
DEMO_ADMIN_PASSWORD=change-this-password
