# Always install devDependencies, even when the ambient environment sets
# NODE_ENV=production (npm omits `dev` by default in that case).
#
# Vite + Tailwind are devDependencies needed to BUILD the frontend, and
# nodemon is needed to run the backend in watch mode. Without this, installs
# silently skip them and the build fails with "vite: not recognized".
include=dev
